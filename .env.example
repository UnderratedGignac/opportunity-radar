# ── AI (Google Gemini via OAuth Bearer token — AGY) ──────────────────────────
# Model: gemini-2.0-flash-lite (smallest/fastest)
GEMINI_ACCESS_TOKEN=AQ.Ab8RN6KG-...

# ── Database (Supabase free tier) ────────────────────────────────────────────
# Sign up free at https://supabase.com
# Project Settings → API → Project URL + anon/public key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# ── Email notifications (optional — Gmail SMTP, free) ────────────────────────
# 1. Enable 2-Step Verification on Gmail
# 2. myaccount.google.com/apppasswords → create App Password
# Leave blank to skip email and use Slack only
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_EMAIL=your@gmail.com

# ── Agency profile (shown in outreach copy) ───────────────────────────────────
AGENCY_NAME=My Agency
AGENCY_SPECIALTY=AI automation for B2B companies

# ── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_CONCURRENCY=3
MIN_SCORE_THRESHOLD=60

# ── Billing (optional — only needed if you charge customers) ─────────────────
# Stripe is free to set up; you only pay fees when processing real payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PILOT=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...
